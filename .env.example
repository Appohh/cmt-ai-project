MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cmt
MYSQL_USER=cmt_user
MYSQL_PASSWORD=change_this_variable
MYSQL_ROOT_PASSWORD=change_this_variable

# Optional: override MySQL with local SQLite for quick testing without Docker
# DATABASE_URL=sqlite:///./cmt_local.db

# Auth & File Storage
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads

# AI Reviewer Matching & Topic Tags (LLMProviderComponent): local (default) | ollama | gemini | openai
AI_PROVIDER=local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini